Check forwarding is enabled or not
pravin@docker-01:~$ cat /proc/sys/net/ipv4/ip_forward
1

pravin@docker-01:~$ sudo iptables -t nat -A PREROUTING -p tcp --dport 8080 -j DNAT --to-destination 172.17.0.2:80
pravin@docker-01:~$ sudo iptables -A FORWARD -p tcp -d 172.17.0.2 --dport 80 -j ACCEPT
pravin@docker-01:~$ curl http://192.168.1.10:8080

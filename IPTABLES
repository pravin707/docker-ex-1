USE of IPTables to forward traffic after creation of container

#Creating NGINX Container without port

pravin@docker-01:~$ sudo docker run -d --name web nginx
pravin@docker-01:~$ docker ps
CONTAINER ID   IMAGE     COMMAND                  CREATED         STATUS         PORTS     NAMES
e31c010826cf   nginx     "/docker-entrypoint.…"   1 minutes ago   Up 1 minutes   80/tcp    web
#Get container IP: 
pravin@docker-01:~$ sudo docker inspect -f '{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}' web 
172.17.0.2
pravin@docker-01:~$ curl http://172.17.0.2:80
